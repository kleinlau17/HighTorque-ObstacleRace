+"""Run in the rt9 release's navigation environment, with PYTHONPATH set to the release root."""
+import unittest
+from types import SimpleNamespace
+
+import numpy as np
+
+from navigation.observed_footing import FloorHistory
+
+
+class FootingFrustumTest(unittest.TestCase):
+    def test_gradual_exit_and_visible_depth_hole(self):
+        # Downward inclined RGB-D camera on level ground. All uncorrupted
+        # pixel depths are analytical ray/plane intersections.
+        v, u = np.mgrid[:192, :256]
+        intrinsics = (242., 242., 128., 96.)
+        rays = np.stack(((u-128.)/242., (v-96.)/242., np.ones_like(u)), axis=-1)
+        c = np.sqrt(.5)
+        rotation = np.array([[0., -c, c], [-1., 0., 0.], [0., -c, -c]])
+        camera = SimpleNamespace(rays=rays, intrinsics=intrinsics,
+                                 rotation32=rotation, position32=np.array([.075, 0., 0.]))
+        plane = SimpleNamespace(valid=True, normal=np.array([0., 0., 1.]), offset=.45)
+        depth = (-plane.offset / (rays @ rotation[2])).astype(np.float32)
+        feet = np.array([[x, y] for x in np.linspace(.70, .80, 6)
+                          for y in np.linspace(.04, .08, 4)])
+
+        for corrupt in (False, True):
+            history = FloorHistory()
+            for i, x in enumerate(np.linspace(0., .72, 121)):
+                measurement = depth if not corrupt or i == 0 else np.full_like(depth, np.nan)
+                frame = SimpleNamespace(time=1+i*.025, depth=measurement)
+                view = history.observe(frame, np.eye(3), [x, 0., 0.], camera, plane)
+                if i == 0:
+                    self.assertTrue(view.supports(feet))
+            self.assertEqual(view.supports(feet-[x, 0.]), not corrupt)
+
+
+if __name__ == '__main__':
+    unittest.main()
