+        self.assertEqual(nav.drive_floor,0.)
+        with nav.control_lock:
+            np.testing.assert_array_equal(publish(12.02,old_command,np.eye(3)),0.)
+        for i in range(1,16):
+            step(nav,12.+i*.1,.054,.054,floor=False)
+        self.assertEqual(nav.drive_floor,0.)
+        self.assertLess(abs(nav.last_cmd[1]),.15)
+
+    def test_stalled_without_passage_recovers_on_two_confirmed_post_hold_captures(self):
+        nav=BoxServo()
