+        self.assertEqual(nav.entry_hold,'no_progress')
+        self.assertEqual(step(nav,11.3,.12,.12)[1],0.)
+        self.assertGreater(step(nav,11.4,.12,.12)[1],.20)
+        self.assertIsNone(nav.entry_hold)
+
+    def test_two_new_exposures_reanchor_opposite_estimator_and_resume(self):
+        nav=BoxServo()
+        for t in (10.,10.1):
+            self.assertEqual(step(nav,t,.10,-.09)[1],0.)
+        self.assertEqual(nav.entry_hold,'visual_pose_disagreement')
+        command=step(nav,10.2,.10,-.09)
+        self.assertGreater(command[1],0.)
+        self.assertTrue(nav.drive_rebased)
+        self.assertAlmostEqual(nav.drive_anchor[1],.407-.10)
+        for i,optical in enumerate((.08,.06,.045,.034)):
+            step(nav,10.3+i*.1,optical,-.09)
+            self.assertIsNone(nav.entry_hold)
+            self.assertEqual(nav.drive_floor,0.)
+        last=nav.frame
+        hook=nav.publication(last,20.)
+        np.testing.assert_array_equal(hook(last.first_seen+FIRST_BOX_LEASE_S+.01,nav.last_cmd,np.eye(3)),0.)
+        step(nav,10.8,.034,-.09,missed=True)
+        self.assertEqual(nav.entry_hold,'first_crate_lost')
+        np.testing.assert_array_equal(nav.last_cmd,0.)
+        step(nav,10.9,.030,-.09)
+        self.assertTrue(nav.entry_hold)
+        step(nav,11.,.030,-.09)
+        self.assertIsNone(nav.entry_hold)
+        step(nav,11.2,.025,-.09,distance=.53)
+        step(nav,11.4,.025,-.09,distance=.41)
+        self.assertEqual(nav.phase,'along')
+        self.assertAlmostEqual(nav.drive_anchor[1],.407-.025)
+
+    def test_smaller_but_opposite_errors_reanchor_without_repeated_holds(self):
+        nav=BoxServo()
+        for i in range(4):
+            command=step(nav,10.+.1*i,.037,-.020)
+        self.assertIsNone(nav.entry_hold)
+        self.assertTrue(nav.drive_rebased)
+        self.assertGreater(command[1],.08)
+
+    def test_measurements_moving_away_cancel_translation_until_they_settle(self):
+        nav=BoxServo()
+        for i in range(12):
+            error=.054+.012*i
+            command=step(nav,10.+.1*i,error,error)
+            if i>=4:
+                self.assertEqual(nav.entry_hold,'visual_motion_away')
+                np.testing.assert_array_equal(command,0.)
+        for i in range(8):
+            command=step(nav,11.2+.1*i,error,error)
+        self.assertIsNone(nav.entry_hold)
+        self.assertGreater(command[1],.25)
+
+    def test_jump_needs_confirmation_and_slow_measured_motion_does_not_boost(self):
+        nav=BoxServo()
+        for i in range(10):
+            remaining=.14-.003*i
+            step(nav,10.+.1*i,remaining,remaining)
