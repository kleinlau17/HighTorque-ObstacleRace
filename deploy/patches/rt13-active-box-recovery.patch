+"""Integration checks for starting and ending a capture-bound observation maneuver."""
+from dataclasses import replace
+from pathlib import Path
+import sys
+import unittest
+
+import numpy as np
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from deploy.shared_navigation import PublishedPlan, TurnCutoff
+from navigation.box_passage import PassageChoice
+from navigation.box_servo import BoxFrame, BoxServo
+from navigation.box_view_recovery import View
+
+
+class HandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.servo=BoxServo()
+        self.frame=BoxFrame(np.zeros(2),np.zeros(2),(np.array([.85,.13]),),
+            0.,-1.,4.,None,0.,first_seen=2.,first_relative=np.array([.85,.13]),
+            passages=(-.42,),passage_seen=(2.,))
+
+    def commit(self,t,index=0,**changes):
+        view=View(t,index,None,0,True,None)
+        self.servo.pending_frame=replace(self.frame,stamp=t,view=view,**changes)
+        self.servo.commit_frame()
+        return self.servo.command(t+.01,0.)
+
+    def test_fresh_pivot_after_stale_first_crate_never_revives_old_translation(self):
+        self.commit(4.)
+        cmd=self.commit(5.)
+        self.assertGreater(abs(cmd[2]),.17)
+        np.testing.assert_array_equal(cmd[:2],0.)
+        frame=self.servo.frame
+        deadline=self.servo.observation_deadline(frame,6.)
+        self.assertGreater(deadline,5.05)
+        plan=PublishedPlan(tuple(cmd),deadline,box_servo=self.servo.publication(frame,deadline))
+        def sent(stamp,imu_stamp):
+            return plan.evaluate(stamp,(imu_stamp,[0.,0.,0.,1.]),np.eye(3),TurnCutoff())[0]
+        self.assertGreater(abs(sent(5.06,5.06)[2]),.17)
+        self.assertFalse(any(sent(5.06,4.8)))
+        self.assertFalse(any(sent(deadline,deadline)))
+        self.commit(5.2)
+        self.assertFalse(any(sent(5.21,5.21)))
+
+    def test_blocked_side_restarts_the_approach_from_in_front_of_the_same_crate(self):
+        from navigation.box_passage import Edge, PassageChoice
+        cx=.62
+        xs,ys=np.meshgrid(np.linspace(cx-.22,cx+.10,28),np.linspace(-.45,.45,70))
+        floor=np.column_stack((xs.ravel(),ys.ravel()))
+        edges=[Edge(-.43,0.,.40,.78),Edge(.40,0.,.40,.78)]
+        choice=PassageChoice()
+        for stamp in (1.,1.16):
+            choice.observe(stamp,edges,floor,np.zeros(len(floor)),(cx,0.),.55)
+        self.assertLess(choice.offset,0.)
+        self.servo.phase='along'
+        self.servo.along_started=1.
+        def see(t,relative):
+            self.servo.frame=replace(self.frame,stamp=t,first_seen=t,first_relative=np.array(relative),
+                passages=(choice.offset,),passage_seen=(t,),
+                view=View(t,0,relative,int(np.sign(choice.offset)),True,None,1))
+            return self.servo.command(t+.01,0.)
+        see(1.17,(.42,0.))
+        solid=np.column_stack((np.linspace(cx-.05,cx+.05,15),np.full(15,-.21)))
+        for stamp in (1.35,1.52):
+            choice.observe(stamp,edges,np.vstack((floor,solid)),np.r_[np.zeros(len(floor)),np.full(15,.15)],
+                           (cx,0.),.55)
+        self.assertGreater(choice.offset,0.)
+        for t in (1.53,1.73,2.30):
+            cmd=see(t,(.42,.20))
+            np.testing.assert_array_equal(cmd[:2],0.)
+            self.assertEqual(self.servo.phase,'along')
+        see(2.5,(.62,.20))
+        self.assertEqual(self.servo.phase,'enter')
+
+    def test_stationary_between_pulse_and_transition_thresholds_can_advance(self):
+        self.servo.phase='along'
+        self.servo.along_started=4.
+        self.frame=replace(self.frame,position=np.array([.85+.38-.05,-.29]))
+        for t in (4.,4.18,4.36,4.53):
+            self.assertAlmostEqual(self.commit(t)[0],0.)
+        self.assertAlmostEqual(self.commit(4.60)[0],.20)
+        self.frame=replace(self.frame,position=np.array([.85+.38-.035,-.29]))
+        self.assertAlmostEqual(self.commit(4.65)[0],0.)
+
+    def test_stationary_entry_completion_still_drives_along_first_crate(self):
+        boxes=(np.array([.85,.13]),np.array([1.35,-.17]),np.array([1.85,.13]))
+        self.frame=replace(self.frame,centers=boxes,position=np.array([.49,-.29]),
+                           first_relative=np.array([.36,.42]),passages=(-.42,.42,-.42))
+        self.commit(4.,first_seen=4.)
+        self.assertEqual((self.servo.index,self.servo.phase),(0,'along'))
+        self.assertGreater(self.commit(4.15,first_seen=4.15)[0],.15)
+
+    def test_third_crate_hands_off_only_with_current_lane(self):
+        self.servo.phase='lane_entry'
+        self.servo.index=2
+        boxes=tuple(np.array([x,y]) for x,y in ((.4,.15),(1.,-.15),(1.6,.15)))
+        self.frame=replace(self.frame,centers=boxes,position=np.array([1.94,0.]),
+                           passages=(-.42,.42,-.42),exit_lane_seen=False)
+        self.commit(4.,2)
+        cmd=self.commit(5.,2)
+        self.assertFalse(self.servo.done)
+        self.assertGreater(abs(cmd[2]),.17)
+        np.testing.assert_array_equal(cmd[:2],0.)
+        self.commit(5.15,2,exit_lane_seen=True,exit_lane_heading=0.)
+        self.assertFalse(self.servo.done)
+        self.assertIsNone(self.commit(5.31,2,exit_lane_seen=True,exit_lane_heading=0.))
+        self.assertTrue(self.servo.done)
+
+
+class PublisherRecoveryTests(unittest.TestCase):
+    def test_standing_guard_restarts_without_reusing_expired_box_translation(self):
+        from types import SimpleNamespace
+        from deploy.shared_navigation import supervised_request
+        from navigation.runtime import OnboardNavigation
+        from navigation.box_motion_watch import BoxMotionWatch
+        nav=OnboardNavigation.__new__(OnboardNavigation)
+        nav.crates=BoxServo()
+        nav.initial_yaw=0.;nav.snapshot_time=None;nav.motion_survey=None
+        nav.motion_watch=BoxMotionWatch()
+        plan=PublishedPlan((0.,.26,0.),deadline=0.,reason='box_enter',box_servo=lambda *a:None)
+        cutoff=TurnCutoff()
+        times=[]
+        for t in np.arange(0.,5.0,.02):
+            stamp=round(np.floor((t+.0001)*5)/5,4)
+            view=View(stamp,0,None,0,True,None,identity=1)
+            nav.crates.frame=SimpleNamespace(heading=0.,view=view)
+            nav.motion_survey=(stamp,True,True,0.)
+            imu=(t,[0.,0.,0.,1.])
+            vec,reason,_,expiry=supervised_request(plan,t,imu,np.eye(3),cutoff,nav,(t,0.))
+            np.testing.assert_array_equal(vec[:2],0.)
+            if abs(vec[2])>.2:
+                times.append(t)
+                self.assertGreater(expiry,t)
+                self.assertEqual(reason,'motion_reobserve')
+        self.assertLess(max(np.diff([0.]+times+[5.])),2.)
+        for t,imu,survey in ((5.01,None,(5.,True,True,0.)),
+                             (5.1,(5.1,[0.,0.,0.,1.]),(5.1,False,False,0.))):
+            nav.motion_survey=survey
+            vec,_,_,_=supervised_request(plan,t,imu,np.eye(3),cutoff,nav,(t,0.))
+            np.testing.assert_array_equal(vec,0.)
+
+
+class PairSpacingTest(unittest.TestCase):
+    def setUp(self):
+        self.s=BoxServo()
+        self.s.boxes=[np.array(x) for x in [(1.,.30),(1.5,-.075),(2.,.30)]]
+        self.s.passages=[PassageChoice(offset=v) for v in (-.42,.42,0.)]
+        self.s.pos=np.array([.40,0.])
+
+    def see(self,t,i=0,error=.075,dx=0.):
+        rear,front=self.s.boxes[i:i+2]
+        detections=[(rear,rear-self.s.pos),(front,front-self.s.pos+[dx,error])]
+        self.s._refine_spacing(t,detections)
+        return detections
+
+    def test_commit_at_target_shift_and_keep_capture_and_passage_identity(self):
+        old=self.s.boxes[1]
+        passage=self.s.passages[1]
+        capture=BoxFrame(np.zeros(2),np.zeros(2),tuple(self.s.boxes),0.,-1.,1.,None,0.)
+        for t in [1.,1.17,1.34,1.51,1.68]:self.see(t)
+        self.assertIs(self.s.boxes[1],old)
+        self.s.phase='shift'
+        associations=self.see(1.85)
+        self.assertAlmostEqual(self.s.boxes[1][1],0.)
+        self.assertEqual(capture.centers[1][1],-.075)
+        self.assertIs(associations[1][0],self.s.boxes[1])
+        self.assertIs(self.s.passages[1],passage)
+        self.assertEqual(passage.offset,.42)
+        self.assertEqual(len(self.s.spacing_corrections),1)
+
+    def test_repeated_sightings_cannot_grant_passage_to_new_box(self):
+        for t in [1.,1.17,1.34,1.51,1.68]:self.see(t)
+        self.s.boxes.insert(0,np.array([.5,-.05]))
+        self.s.passages.insert(0,PassageChoice())
+        self.s.phase='shift'
+        self.s._refine_spacing(1.8,[])
+        self.assertFalse(self.s.spacing_corrections)
+        self.assertEqual(self.s.passages[0].offset,0.)
+
+    def test_second_to_third_pair_and_contradictory_or_expired_observations(self):
+        self.s.index=1
+        self.s.pos[0]=.9
+        self.s.phase='shift'
+        for t in [1.,1.17,1.34,1.51,1.68]:
+            self.see(t,i=1,error=-.05,dx=.12)
+        self.assertFalse(self.s.spacing_corrections)
+        for t in [2.,2.2,2.4]:
+            self.see(t,i=1,error=-.05)
+        self.s._refine_spacing(7.,[])
+        self.assertFalse(self.s.spacing_corrections)
+        for t in [8.,8.2,8.4,8.6]:
+            self.see(t,i=1,error=-.05)
+        self.assertEqual(len(self.s.spacing_corrections),1)
+        self.assertAlmostEqual(self.s.boxes[2][1],.25)
+        self.assertEqual(self.s.passages[2].offset,0.)
+
+
+if __name__=='__main__':unittest.main()
