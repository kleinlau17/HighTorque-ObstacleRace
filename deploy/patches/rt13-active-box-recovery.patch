+"""Motion watch regression tests on timestamped signals; no robot or dynamics simulator."""
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from navigation.box_motion_watch import BoxMotionWatch
+
+
+def sample(w,t,*,x=0.,box_x=None,yaw=0.,camera=None,imu=None,key=1,speed=0.,
+           active=True,clear=True,turning=False,zero=None,direction=0):
+    camera=t if camera is None else camera
+    return w.update(t,capture_stamp=camera,relative=(1.-(x if box_x is None else box_x),0.),
+                    landmark=key,yaw=yaw,imu_stamp=t if imu is None else imu,leg_stamp=t,
+                    leg_xy=(x,0.),leg_velocity=(speed,0.),pivot_clear=clear,pivot_stamp=camera,
+                    turning=turning,scan_direction=direction,active=active,zero_since=zero)
+
+
+class WatchTest(unittest.TestCase):
+    def test_missing_commands_and_underpowered_scan_cannot_mask_stationarity(self):
+        for zero,turning in ((None,True),(0.,False)):
+            w=BoxMotionWatch()
+            statuses=[sample(w,i*.04,turning=turning,zero=zero) for i in range(151)]
+            first=next(i for i,s in enumerate(statuses) if abs(s.yaw_request)>.7)
+            self.assertAlmostEqual(first*.04,1.2)
+            self.assertGreaterEqual(w.attempts,7)
+            self.assertTrue(all(s.recovery_due for s in statuses[first:]))
+            self.assertGreaterEqual(max(s.still_s for s in statuses),6.)
+            self.assertTrue(any(s.reason=='restart_observe' for s in statuses[first:]))
+            self.assertTrue(any(s.yaw_request<-.7 for s in statuses))
+            self.assertTrue(all(s.yaw_request==0. for s in statuses[first+8:first+16]))
+
+    def test_callbacks_and_frozen_or_reordered_frames_do_not_count_as_progress(self):
+        w=BoxMotionWatch()
+        sample(w,10.)
+        for t in (10.03,10.06,10.09,10.12,10.15):
+            s=sample(w,t,x=(t-10.)*.3,speed=.3,yaw=t-10.,camera=10.,imu=10.,turning=True)
+            self.assertEqual(s.reason,'watching')
+        s=sample(w,11.21,x=.5,speed=.3,yaw=.8,camera=10.,imu=10.,turning=True)
+        self.assertTrue(s.recovery_due)
+        self.assertEqual(s.yaw_request,0.)
+        self.assertEqual(s.reason,'awaiting_turn_evidence')
+        # A delayed capture is not a fresh scene certification for the publisher.
+        sample(w,11.25,camera=9.9,imu=9.9)
+        self.assertEqual(w.last_capture,10.)
+        s=sample(w,11.3,turning=True,clear=False)
+        self.assertFalse(s.yaw_request)
+        self.assertGreater(w.update(11.32,capture_stamp=11.3,yaw=0.,imu_stamp=11.32,
+                                    pivot_stamp=11.3,pivot_clear=True).yaw_request,.7)
+
+    def test_motion_requires_same_landmark_and_concordant_legs(self):
+        for motion in ('encoder_only','wrong_direction','new_identity','clipped_single_frame','slow_drift'):
+            w=BoxMotionWatch()
+            for i in range(38):
+                t=i*.05
+                x=t*(.008 if motion=='slow_drift' else .11)
+                box=x if motion in ('slow_drift','new_identity') else (0. if motion=='encoder_only' else -x)
+                if motion=='clipped_single_frame':
+                    box=x if i==10 else 0.
+                s=sample(w,t,x=x,box_x=box,speed=.008 if motion=='slow_drift' else .11,
+                         key=i if motion=='new_identity' else 1)
+            self.assertTrue(s.recovery_due,motion)
+            self.assertGreater(s.still_s,1.7,motion)
+
+    def test_measured_translation_and_measured_turn_release_then_rearm(self):
+        w=BoxMotionWatch()
+        for i in range(20):
+            t=i*.08
+            s=sample(w,t,x=t*.16,speed=.16)
+        self.assertFalse(s.recovery_due)
+        self.assertLess(s.still_s,.3)
+        w=BoxMotionWatch()
+        for i in range(32):
+            t=i*.04
+            s=sample(w,t,zero=0.,direction=1.)
+        self.assertGreater(s.yaw_request,.7)
+        for i in range(1,7):
+            t=1.24+i*.04
+            s=sample(w,t,yaw=i*.025,zero=0.,direction=1.)
+        self.assertFalse(s.recovery_due)
+        self.assertLess(s.still_s,.21)
+        # Continued zero forwarding and stationary IMU must trigger a new attempt.
+        for i in range(40):
+            s=sample(w,1.52+i*.04,yaw=.15,zero=0.,direction=1.)
+        self.assertTrue(s.recovery_due)
+        self.assertGreater(w.attempts,1)
+
+    def test_guard_can_trigger_immediately_but_only_fresh_floor_and_imu_authorize_pivot(self):
+        w=BoxMotionWatch()
+        s=sample(w,5.,zero=3.5,clear=False)
+        self.assertEqual((s.reason,s.yaw_request),('awaiting_turn_evidence',0.))
+        s=sample(w,5.02,zero=3.5,imu=4.7)
+        self.assertTrue(s.recovery_due)
+        self.assertFalse(s.yaw_request)
+        s=sample(w,5.04,zero=3.5,direction=-1)
+        self.assertLess(s.yaw_request,-.7)
+        s=sample(w,5.06,zero=3.5,yaw=-.16)
+        self.assertEqual(s.yaw_request,0.)
+        s=sample(w,5.08,active=False)
+        self.assertEqual((s.reason,w.attempts),('inactive',0))
+
+    def test_fast_floor_does_not_discard_a_delayed_landmark_from_the_same_camera(self):
+        w=BoxMotionWatch()
+        for i in range(80):
+            t=20.+i*.02
+            camera=20.+(i//8)*.16
+            late=camera-.16
+            s=w.update(t,capture_stamp=late,relative=(1.-.18*(late-20.),0.),landmark=1,
+                       leg_xy=(.18*(t-20.),0.),leg_velocity=(.18,0.),leg_stamp=t,
+                       yaw=0.,imu_stamp=t,pivot_stamp=camera,pivot_clear=True)
+        self.assertTrue(w.confirmed)
+        self.assertFalse(s.recovery_due)
+        self.assertGreater(w.last_capture,w.last_direct_stamp)
+        self.assertLess(s.still_s,.55)
+
+    def test_without_crate_fresh_floor_and_measured_imu_can_confirm_a_real_scan(self):
+        for fresh in (False,True):
+            w=BoxMotionWatch()
+            for i in range(10):
+                t=10.+i*.05
+                s=w.update(t,relative=None,landmark=None,imu_stamp=t,
+                           yaw=(3.11+.5*i*.05+3.14159)%(2*3.14159)-3.14159,
+                           pivot_stamp=t if fresh else 10.,pivot_clear=True,
+                           turning=True)
+            self.assertEqual(w.confirmed,fresh)
+            if fresh:
+                self.assertLess(s.still_s,.18)
+
+    def test_loss_of_box_or_phase_does_not_reset_static_timer(self):
+        w=BoxMotionWatch()
+        sample(w,0.)
+        for i in range(1,25):
+            t=i*.08
+            s=w.update(t,capture_stamp=t,relative=None,landmark=i,yaw=0.,imu_stamp=t,
+                       pivot_clear=True,turning=bool(i%2))
+        self.assertTrue(s.recovery_due)
+        self.assertAlmostEqual(s.still_s,1.92)
+
+if __name__=='__main__':unittest.main()
