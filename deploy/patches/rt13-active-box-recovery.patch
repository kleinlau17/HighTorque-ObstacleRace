diff --git a/scripts/test_rt13_active_drive.py b/scripts/test_rt13_active_drive.py
new file mode 100644
index 0000000000000000000000000000000000000000..46067d38fff7e3002ace8bfc02a47ce3e0cb31e9
--- /dev/null
+++ b/scripts/test_rt13_active_drive.py
@@ -0,0 +1,140 @@
+"""First-crate side-step control uses independent crate/outer-stripe RGB-D captures."""
+from pathlib import Path
+import sys
+import unittest
+
+import numpy as np
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from navigation.box_servo import BoxFrame, BoxServo, FIRST_BOX_LEASE_S
+
+
+def capture(t, optical, estimated, *, offset=.407, distance=.65, floor=True, missed=False):
+    # Positive and negative errors point in the two directions along the lane cross section.
+    return BoxFrame(position=np.array([1.-distance, offset-estimated]), velocity=np.zeros(2),
+                    centers=(np.array([1.,0.]),), heading=0., side=np.sign(offset), stamp=t,
+                    leg_anchor=None,kick_until=0., first_seen=t, previous_first_seen=t-.1,
+                    first_relative=np.array([distance,optical-offset]),first_seen_streak=0 if missed else 2,
+                    passages=(offset,),passage_seen=(t,),passage_boundary_seen=(t if floor else -np.inf,))
+
+
+def step(nav, t, optical, estimated, **kwargs):
+    nav.frame=capture(t,optical,estimated,**kwargs)
+    return nav.command(t+.01,0.)
+
+
+class ActiveLateralDrive(unittest.TestCase):
+    def test_optically_stationary_weak_drive_reaches_breakaway_on_either_side(self):
+        for sign in (-1,1):
+            with self.subTest(sign=sign):
+                nav=BoxServo()
+                for i in range(41):
+                    command=step(nav,10.+i*.1,sign*.054,sign*.054,offset=sign*.407)
+                    if i==0:
+                        self.assertAlmostEqual(sign*command[1],.1242)
+                    if i>=12:
+                        self.assertAlmostEqual(sign*command[1],.32)
+                self.assertIsNone(nav.entry_hold)
+                # A new capture showing a 6 mm step removes the augmented command at once.
+                command=step(nav,14.1,sign*.048,sign*.054,offset=sign*.407)
+                self.assertEqual(nav.drive_floor,0.)
+                self.assertAlmostEqual(sign*command[1],.1242)
+                command=step(nav,14.2,sign*.020,sign*.025,offset=sign*.407)
+                self.assertEqual(nav.drive_floor,0.)
+                self.assertLess(abs(command[1]),.07)
+
+    def test_ticks_do_not_witness_steps_and_unsupported_floor_drops_boost(self):
+        nav=BoxServo()
+        step(nav,10.,.054,.054)
+        for t in np.linspace(10.,10.5,40):
+            nav.command(t,0.)
+        self.assertEqual(len(nav.drive_samples),1)
+        self.assertEqual(nav.drive_floor,0.)
+        for i in range(14):
+            step(nav,10.6+i*.1,.054,.054)
+        self.assertGreater(nav.drive_floor,.25)
+        old=nav.frame
