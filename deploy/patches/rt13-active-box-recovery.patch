+import unittest
+import numpy as np
+from navigation.box_passage import Edge, PassageChoice
+from navigation.box_view_recovery import BoxViewRecovery, View, ViewFloor, ViewTrack
+
+
+class TestBoxViewRecovery(unittest.TestCase):
+    def setUp(self):
+        self.policy=BoxViewRecovery()
+
+    def run_at(self,t,*,view=None,waiting=True,offset=0.,i=0,phase='enter',pos=(0.,0.)):
+        if view is None:view=View(t,i,None,0,True,None,1)
+        return self.policy.command(t,0.,0.,np.array(pos),i,phase,offset,waiting,view)
+
+    def test_unseen_target_with_current_clear_space_only_turns(self):
+        self.run_at(0.)
+        for t in (.9,5.1,36.,50.1):
+            cmd=self.run_at(t)
+            self.assertTrue(np.allclose(cmd[:2],0))
+            self.assertEqual(self.policy.action,'scan')
+        for v in (View(40.,0,(.7,.2),1,True,(-.16,0),1),
+                  View(60.,0,None,0,False,None,1)):
+            np.testing.assert_array_equal(self.run_at(60.,view=v),0.)
+
+    def test_changed_side_near_same_box_never_releases_lateral(self):
+        v=lambda t,x:View(t,0,(x,.35),-1,True,None,1)
+        self.assertIsNone(self.run_at(0.,view=v(0.,.65),waiting=False,offset=-.42))
+        for sec in range(1,12):
+            cmd=self.run_at(sec,view=v(sec,.34),waiting=False,offset=.42)
+            self.assertIsNotNone(cmd)
+            np.testing.assert_array_equal(cmd[:2],0.)
+        self.assertIsNone(self.run_at(14.,view=v(14.,.63),waiting=False,offset=.42))
+
+    def test_retreat_lease_cannot_authorize_a_different_crate(self):
+        self.run_at(0.,view=View(0.,0,(.6,.32),-1,True,(-.15,0.),1))
+        self.run_at(3.,view=View(3.,0,(.6,.32),-1,True,(-.15,0.),1))
+        self.assertEqual(self.policy.action,'retreat')
+        cmd=self.run_at(3.04,view=View(3.04,0,(.6,.32),-1,True,(-.15,0.),1))
+        self.assertLess(cmd[0],-.08)
+        cmd=self.run_at(3.08,view=View(3.08,0,(.5,.12),0,True,None,2))
+        np.testing.assert_array_equal(cmd[:2],0.)
+        self.assertNotEqual(self.policy.action,'retreat')
+
+    def test_measured_opposite_passage_can_be_selected_before_approach(self):
+        choice=PassageChoice()
+        center=np.array([.62,0.])
+        x,y=np.meshgrid(np.arange(-.25,.14,.008),np.arange(-.43,.43,.008))
+        xy=np.column_stack((x.ravel(),y.ravel()))+center
+        right=Edge(-.41,0.,.30,.83)
+        left=Edge(.41,0.,.30,.83)
+        for t in (1.,1.14):
+            choice.observe(t,[right],xy,np.zeros(len(xy)),center,.55)
+        self.assertLess(choice.offset,0.)
+        original=View(1.14,0,tuple(center),-1,True,None,1)
+        self.assertIsNone(self.run_at(1.14,view=original,waiting=False,offset=choice.offset))
+        obstacle=center+np.column_stack((np.linspace(-.09,-.03,8),np.full(8,-.23)))
+        new_xy=np.vstack((xy,obstacle))
+        heights=np.r_[np.zeros(len(xy)),np.full(8,.18)]
+        for t in (1.28,1.42):
+            choice.observe(t,[right,left],new_xy,heights,center,.55)
+        self.assertGreater(choice.offset,0.)
+        adjacent=View(1.42,0,(.28,.31),1,False,None,1)
+        np.testing.assert_array_equal(self.run_at(1.42,view=adjacent,waiting=False,offset=choice.offset),0.)
+        ahead=View(2.42,0,tuple(center),1,True,None,1)
+        self.assertIsNone(self.run_at(2.42,view=ahead,waiting=False,offset=choice.offset))
+
+    def test_obstacles_and_missing_depth_in_return_strip(self):
+        f=ViewFloor()
+        f.ground[:]=8.
+        start,end=np.array([-.53,-.31]),np.array([-.67,-.32])
+        self.assertTrue(f.supports(10.,start,end))
+        f.hazard[:]=9.9
+        self.assertFalse(f.supports(10.,start,end))
+        f.hazard[:]=-np.inf;f.ground[:]=-np.inf
+        self.assertFalse(f.supports(10.,start,end))
+
+    def test_no_box_match_does_not_reuse_retreat(self):
+        track=ViewTrack()
+        v=track.capture(6.,[0.,0.],2.,[.7,.1],None,0.,1,'shift',turn_clear=True)
+        self.assertIsNone(v.retreat)
+        self.assertIsNone(v.relative)
+        self.assertTrue(v.turn_space)
+
+    def test_latest_unmatched_frame_or_pivot_veto_revokes_old_permissions(self):
+        track=ViewTrack()
+        choice=PassageChoice()
+        choice.view_floor.turn_space=True
+        center=np.array([.64,.2])
+        v=track.capture(3.,[0.,0.],3.,center,choice,-.42,0,'along',turn_clear=True)
+        self.assertTrue(v.turn_space)
+        v=track.capture(3.08,[0.,0.],3.,center,choice,-.42,0,'along',turn_clear=False)
+        self.assertFalse(v.turn_space)
+        self.assertIsNone(v.relative)
+        self.assertIsNone(v.retreat)
+        v=track.capture(3.16,[0.,0.],3.16,center,choice,-.42,0,'along',turn_clear=False)
+        self.assertFalse(v.turn_space)
+        v=track.capture(3.24,[0.,0.],3.24,[.29,.22],choice,-.42,0,'along',turn_clear=True)
+        self.assertFalse(v.turn_space)
+
+    def test_clear_stance_next_to_face_can_pivot_but_projecting_corner_cannot(self):
+        track=ViewTrack()
+        choice=PassageChoice()
+        choice.view_floor.turn_space=True
+        face=track.capture(1.,(0.,0.),1.,(.47,.01),choice,0.,0,'enter',turn_clear=True)
+        self.assertTrue(face.turn_space)
+        corner=track.capture(1.2,(0.,0.),1.2,(.35,.35),choice,0.,0,'enter',turn_clear=True)
+        self.assertFalse(corner.turn_space)
+        self.assertEqual(corner.blocked_by,'crate_inside_pivot_envelope')
+
+    def test_observed_drop_or_raised_obstacle_overrides_recently_walked_ground(self):
+        f=ViewFloor()
+        f.ground[:]=1.
+        start,end=np.array([-.58,-.32]),np.array([-.72,-.32])
+        self.assertTrue(f.supports(2.,start,end))
+        for height in (-.09,.13):
+            f.hazard[:]=-np.inf
+            f.observe(2.,np.tile([.3,.01],(8,1)),np.full(8,height),[.97,.31])
+            self.assertFalse(f.supports(2.,start,end))
+
+    def test_reverse_distance_cannot_exceed_optical_or_walked_displacement(self):
+        track=ViewTrack()
+        choice=PassageChoice()
+        choice.view_floor.turn_space=True
+        choice.view_floor.ground[:]=1.
+        track.capture(1.,[0.,0.],1.,[.8,.24],choice,-.42,0,'enter',turn_clear=True)
+        view=track.capture(1.2,[.18,0.],1.2,[.72,.24],choice,0.,0,'enter',turn_clear=True)
+        self.assertAlmostEqual(.18-view.retreat[0],.08)
+        # Odom still indicates forward approach but the optical range increased.
+        view=track.capture(1.4,[.11,0.],1.4,[.81,.24],choice,0.,0,'enter',turn_clear=True)
+        self.assertIsNone(view.retreat)
+
+    def test_lane_search_yaw_only_and_returns_lane_control(self):
+        self.run_at(0.,phase='lane_entry')
+        cmd=self.run_at(1.,phase='lane_entry')
+        self.assertTrue(abs(cmd[2])>.17)
+        self.assertTrue(np.allclose(cmd[:2],0))
+        self.assertIsNone(self.run_at(2.,phase='lane_entry',waiting=False))
+
+    def test_arriving_at_scan_heading_immediately_selects_next_view(self):
+        first=self.run_at(10.)
+        self.assertGreater(first[2],.35)
+        aim=self.policy.aim
+        sample=View(10.2,0,None,0,True,None,1)
+        cmd=self.policy.command(10.2,aim,0.,(0.,0.),0,'enter',0.,True,sample)
+        self.assertLess(cmd[2],-.35)
+        np.testing.assert_array_equal(cmd[:2],0.)
+
+    def test_imu_nonresponse_causes_bounded_stronger_rescan_then_other_direction(self):
+        initial=self.run_at(2.)
+        requested=self.run_at(2.38)
+        self.assertGreater(abs(requested[2]),abs(initial[2]))
+        self.assertEqual(self.policy.diagnostic()['crate_view_imu_response'],'strong_rescan')
+        np.testing.assert_array_equal(requested[:2],0.)
+        alternate=self.run_at(2.66)
+        self.assertLess(alternate[2]*initial[2],0.)
+        self.assertEqual(self.policy.diagnostic()['crate_view_scan_pulses'],1)
+
+    def test_short_handoffs_do_not_restart_at_same_view_or_wait(self):
+        a=self.run_at(4.)
+        self.assertIsNone(self.run_at(4.1,waiting=False,offset=-.42))
+        b=self.run_at(4.2)
+        self.assertLess(a[2]*b[2],0.)
+        self.assertGreater(abs(b[2]),.35)
+
+    def test_dual_blocked_passages_can_pivot_from_confirmed_stance(self):
+        track=ViewTrack()
+        choice=PassageChoice()
+        choice.view_floor.turn_space=True
+        choice.widths=(.15,.16)
+        v=track.capture(1.,(0.,0.),1.,(.7,.12),choice,0.,0,'enter',turn_clear=True)
+        cmd=self.run_at(1.,view=v)
+        self.assertIsNone(v.retreat)
+        np.testing.assert_array_equal(cmd[:2],0.)
+        self.assertGreater(abs(cmd[2]),.35)
+
+    def test_missing_safety_evidence_has_reason_and_restoration_immediately_scans(self):
+        track=ViewTrack()
+        v=track.capture(2.,(0.,0.),None,None,None,0.,0,'enter',turn_block='near_field_raised')
+        np.testing.assert_array_equal(self.run_at(2.,view=v),0.)
+        self.assertEqual(self.policy.hold_reason,'near_field_raised')
+        self.assertGreater(abs(self.run_at(2.1)[2]),.35)
+        np.testing.assert_array_equal(self.run_at(2.6,view=View(2.1,0,None,0,True,None,1)),0.)
+        self.assertEqual(self.policy.hold_reason,'fresh_depth_view_required')
+        v=View(2.7,0,None,0,True,None,1)
+        np.testing.assert_array_equal(self.policy.command(2.7,None,0.,(0.,0.),0,'enter',0.,True,v),0.)
+        self.assertEqual(self.policy.hold_reason,'imu_heading_unavailable')
+
+
+class RegisteredFloorTest(unittest.TestCase):
+    def prepare(self, sign=-1, hole=False):
+        self.sign=sign
+        self.c=np.array([.55,-sign*.25])
+        self.outer=Edge(float(self.c[1]+sign*.41),0.,.38,.65)
+        self.inner=Edge(float(self.c[1]+sign*.05),0.,.24,.47)
+        x,y=np.meshgrid(np.arange(-.379,.260,.005),np.arange(.095,.455,.005))
+        if hole:
+            subset=~((x>=-.063)&(x<=-.017)&(y>.214)&(y<.268))
+            x,y=x[subset],y[subset]
+        self.full=np.column_stack((x.ravel(),sign*y.ravel()))+self.c
+        self.choice=PassageChoice()
+        self.choice.view_position=(0.,0.)
+        for t in (1.,1.15,1.3):
+            self.choice.observe(t,[self.outer],self.full,np.zeros(len(self.full)),self.c,.55)
+        self.assertEqual(int(np.sign(self.choice.offset)),sign)
+        self.partial=self.full[self.full[:,0]-self.c[0]>=-.095]
+
+    def observe_partial(self,t,*,dx=0.,dy=0.,outer=True,hazard_height=None,slope=0.):
+        pts=self.partial
+        h=np.zeros(len(pts))
+        if hazard_height is not None:
+            # Six separate current returns within the previously confirmed swept volume.
+            obstacle=self.c+np.column_stack((np.linspace(-.09,-.06,6),np.full(6,self.sign*.24)))
+            pts=np.vstack((pts,obstacle))
+            h=np.r_[h,np.full(6,hazard_height)]
+        self.choice.view_position=(dx,dy)
+        edge=Edge(self.outer.offset-slope*self.c[0],slope,self.outer.near,self.outer.far)
+        edges=([edge] if outer else [])+[self.inner]
+        self.choice.observe(t,edges,pts,h,self.c,.55)
+        return self.choice.offset
+
+    def test_valid_supported_envelope_both_lateral_signs(self):
+        for sign in (-1,1):
+            self.prepare(sign=sign)
+            self.assertGreater(sign*self.observe_partial(1.45,dx=.105,dy=.003),0.)
+
+    def test_partial_coverage_of_registration_envelope_rejects(self):
+        self.prepare(hole=True)
+        self.assertEqual(self.observe_partial(1.45,dx=.105),0.)
+
+    def test_stale_crate_floor_wrong_outer_and_discontinuous_pose_reject(self):
+        for params in ({'t':5.61},{'t':1.45,'dx':.18},{'t':1.45,'dy':.05},
+                       {'t':1.45,'outer':False},{'t':1.45,'slope':.22}):
+            self.prepare()
+            self.assertEqual(self.observe_partial(**params),0.,params)
+
+    def test_current_positive_obstacle_and_negative_drop_veto_cache(self):
+        for h in (.17,-.09):
+            self.prepare()
+            self.assertLess(self.observe_partial(1.45),0.)
+            self.assertEqual(self.observe_partial(1.58,hazard_height=h),0.)
+            self.assertNotIn(0,self.choice.cells)
+            self.assertEqual(self.observe_partial(1.72),0.)
+
+
+if __name__=='__main__': unittest.main()
