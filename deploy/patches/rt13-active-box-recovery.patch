+        # Abruptly switching to a different face is not evidence of physical motion.
+        np.testing.assert_array_equal(step(nav,11.,-.025,-.025),0.)
+        self.assertEqual(nav.entry_hold,'visual_pose_disagreement')
+        np.testing.assert_array_equal(step(nav,11.1,-.025,-.025),0.)
