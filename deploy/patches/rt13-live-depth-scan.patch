diff --git a/scripts/test_rt13_live_depth.py b/scripts/test_rt13_live_depth.py
new file mode 100644
index 0000000000000000000000000000000000000000..719cefa6e069aaa1f3e04edd07402b71b344c50f
--- /dev/null
+++ b/scripts/test_rt13_live_depth.py
@@ -0,0 +1,63 @@
+"""Check the 50 Hz path at measured Jetson processing delays, without running a robot."""
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+import sys
+import numpy as np
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from deploy.shared_navigation import PublishedPlan, TurnCutoff, supervised_request
+from navigation.box_view_recovery import View
+from navigation.box_servo import BoxServo
+from navigation.box_motion_watch import BoxMotionWatch
+from navigation.pivot_depth import MeasuredScan
+from navigation.runtime import OnboardNavigation
+
+
+class DepthScanTests(unittest.TestCase):
+    def setUp(self):
+        self.nav=OnboardNavigation.__new__(OnboardNavigation)
+        self.nav.crates=BoxServo()
+        self.nav.crates.passage_wait=True
+        self.nav.crates.view_recovery.action='scan'
+        self.nav.initial_yaw=0.
+        self.nav.snapshot_time=None
+        self.nav.motion_watch=BoxMotionWatch()
+        self.nav.measured_scan=MeasuredScan()
+        self.cutoff=TurnCutoff()
+        self.plan=PublishedPlan((0.,.28,0.),deadline=1.,reason='box_enter',
+                                box_servo=lambda *a:np.array([0.,.28,0.]))
+
+    def update(self,t,stamp,clear=True,imu=True,geometry=True):
+        frame_stamp=t-.42
+        self.nav.crates.frame=SimpleNamespace(heading=0.,stamp=frame_stamp,
+            view=View(frame_stamp,0,(.43,.35),-1,geometry,None,identity=8))
+        self.nav.motion_survey=(frame_stamp,geometry,False,0.)
+        self.nav.pivot_capture=(stamp,clear)
+        imu=(t,[0,0,0,1]) if imu else None
+        return supervised_request(self.plan,t,imu,np.eye(3),self.cutoff,self.nav,None)
+
+    def test_late_crate_processing_preserves_coherent_yaw_but_no_translation(self):
+        turns=[]
+        for tick in range(53):
+            t=2.+.02*tick
+            vec,reason,_,end=self.update(t,2.+int(tick*.02*6)/6.)
+            self.assertEqual(reason,'box_live_depth_scan')
+            self.assertGreater(end,t)
+            self.assertEqual(tuple(vec[:2]),(0.,0.))
+            turns.append(vec[2])
+        self.assertTrue(all(w>0. for w in turns))
+        self.assertGreater(max(turns),.7)
+
+    def test_fresh_block_or_stale_sensors_or_stale_geometry_revoke(self):
+        for args in [(2.,1.6),(2.,2.,False),(2.,2.,True,False),(2.,2.,True,True,False)]:
+            vec,_,_,_=self.update(*args)
+            self.assertFalse(any(vec))
+        self.nav.crates.passage_wait=False
+        vec,_,_,_=self.update(2.,2.)
+        self.assertFalse(any(vec))
+
+    def test_conflicting_newer_crate_frame_vetoes_immediately(self):
+        self.nav.crates.pending_frame=SimpleNamespace(stamp=1.99,view=View(1.99,0,(.2,.2),0,False,None))
+        vec,_,_,_=self.update(2.,2.)
+        self.assertFalse(any(vec))
