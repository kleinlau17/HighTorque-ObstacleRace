diff --git a/navigation/pivot_depth.py b/navigation/pivot_depth.py
new file mode 100644
index 0000000000000000000000000000000000000000..a7c102b314666f0d17e8ad97f93f3dbea7a3c4e8
--- /dev/null
+++ b/navigation/pivot_depth.py
@@ -0,0 +1,75 @@
+"""Use incoming aligned depth to certify a short pivot while the crate planner is busy."""
+import math
+
+import cv2
+import numpy as np
+
+from navigation.ground import GroundEstimator
+
+
+class PivotDepth:
+    def __init__(self, camera, maps):
+        # One quarter of the planner pixels, with the same calibrated rectification.
+        self.maps=tuple(m[::2,::2].copy() for m in maps)
+        self.rays=camera.rays[::2,::2]@camera.rotation32.T
+        self.position=camera.position32
+        self.ground=GroundEstimator()
+
+    def clear(self, raw_depth, attitude, stamp):
+        depth=cv2.remap(raw_depth,*self.maps,cv2.INTER_NEAREST)
+        body=self.rays*depth[...,None]+self.position
+        level=body@np.asarray(attitude,dtype=np.float32).T
+        valid=np.isfinite(depth)&(depth>.15)&(depth<2.6)
+        ground=self.ground.estimate(level,valid&(body[...,0]>.30),timestamp=stamp)
+        if not ground.valid:
+            return False
+        height=ground.height(level)
+        x,y=body[...,0],body[...,1]
+        near=valid&(x>.20)&(x<.72)&(abs(height)<.032)
+        radius_sq=np.sum(level[...,:2]**2,axis=2)
+        rim=valid&(radius_sq<.35**2)&((height>.10)|(height<-.055))
+        return bool(not np.any(rim) and np.count_nonzero(near&(y>0.)&(y<.25))>=12
+                    and np.count_nonzero(near&(y<0.)&(y>-.25))>=12)
+
+
+class MeasuredScan:
+    """A single operator of yaw during an active depth-backed box search."""
+    def __init__(self):
+        self.key=None
+        self.index=0
+        self.start=None
+        self.target=None
+        self.last_tick=None
+        self.heading_at_start=None
+
+    def reset(self):
+        self.key=self.start=self.target=self.last_tick=None
+        self.index=0
+
+    def request(self,t,yaw,axis,key,direction):
+        if self.key!=key:
+            self.reset()
+            self.key=key
+        wrap=lambda a:math.atan2(math.sin(a),math.cos(a))
+        if self.last_tick is not None and t-self.last_tick>.32:
+            self.start=None
+        self.last_tick=t
+        if self.start is None:
+            self.start=t
+            self.heading_at_start=yaw
+        if self.target is not None and (abs(wrap(self.target-yaw))<.055 or t-self.start>=1.25):
+            self.target=None
+        if self.target is None:
+            for _ in range(2):
+                angle=(.26,-.27,.40,-.39)[self.index%4]
+                self.index+=1
+                self.target=axis+direction*angle
+                if abs(wrap(self.target-yaw))>.055:
+                    break
+            self.start=t
+            self.heading_at_start=yaw
+        error=wrap(self.target-yaw)
+        rate=min(.70,max(.45,2.6*abs(error)))
+        if t-self.start>.36 and abs(wrap(yaw-self.heading_at_start))<.035:
+            rate=.80
+        return (0.,0.,math.copysign(rate,error))
