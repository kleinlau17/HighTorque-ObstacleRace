diff --git a/scripts/test_rt13_entry_recovery.py b/scripts/test_rt13_entry_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..d3dc4eddb12cf0649e7b6d9aea4468820b260eba
--- /dev/null
+++ b/scripts/test_rt13_entry_recovery.py
@@ -0,0 +1,92 @@
+"""First-crate observation leases apply to navigation and its concurrent publisher."""
+from dataclasses import replace
+from pathlib import Path
+import sys
+import unittest
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from navigation.box_servo import BoxFrame, BoxServo, FIRST_BOX_LEASE_S
+
+
+class EntryRecoveryTest(unittest.TestCase):
+    def setUp(self):
+        self.nav = BoxServo()
+        self.frame = BoxFrame(np.zeros(2), np.zeros(2), (np.array([1., -.12]),),
+                              0., 1., 10., None, 0., first_seen=10.,
+                              first_relative=np.array([1.,-.12]), first_seen_streak=2,
+                              previous_first_seen=9.8)
+        self.nav.frame = self.frame
+        self.attitude = np.eye(3)
+
+    def test_unrelated_fresh_frames_and_stale_publisher_cannot_restore_motion(self):
+        planned = self.nav.command(10.02, 0.)
+        self.assertGreater(planned[1], .2)
+        old_hook = self.nav.publication(self.frame, 20.)
+        with self.nav.control_lock:
+            np.testing.assert_array_equal(old_hook(10.+FIRST_BOX_LEASE_S, planned, self.attitude), 0.)
+        self.nav.frame = replace(self.frame, stamp=11., first_seen_streak=0)
+        np.testing.assert_array_equal(self.nav.command(11.05, 0.), 0.)
+        self.assertEqual(self.nav.entry_hold, 'first_crate_lost')
+        self.nav.frame = replace(self.frame, stamp=12., first_seen=12., first_seen_streak=1)
+        for stamp in (12., 12.02, 12.1):
+            np.testing.assert_array_equal(self.nav.command(stamp, 0.), 0.)
+        self.nav.frame = replace(self.frame, stamp=12.2, first_seen=12.2,
+                                 previous_first_seen=12., first_seen_streak=2)
+        self.assertGreater(self.nav.command(12.22, 0.)[1], .2)
+        self.assertEqual(self.nav.index, 0)
+        np.testing.assert_array_equal(old_hook(12.23, planned, self.attitude), 0.)
+
+    def test_frozen_pose_does_not_rearm_on_fresh_detections(self):
+        for t in np.arange(10., 13., .1):
+            self.nav.frame = replace(self.frame, stamp=t, first_seen=t,
+                                     previous_first_seen=t-.1, first_seen_streak=2)
+            self.nav.command(t+.01, 0.)
+        self.assertEqual(self.nav.entry_hold, 'no_progress')
+        np.testing.assert_array_equal(self.nav.last_cmd, 0.)
+        self.nav.frame = replace(self.nav.frame, position=np.array([.1,.08]),
+                                 first_relative=np.array([.9,-.20]))
+        self.assertGreater(self.nav.command(13., 0.)[1], 0.)
+
+    def test_current_visual_pose_must_agree_to_resume(self):
+        self.nav.command(10.01, 0.)
+        self.nav.frame = replace(self.frame, stamp=11., first_seen_streak=0)
+        self.nav.command(11.03, 0.)
+        self.nav.frame = replace(self.frame, stamp=12.2, first_seen=12.2,
+                                 previous_first_seen=12., first_relative=np.array([.8,-.4]))
+        np.testing.assert_array_equal(self.nav.command(12.24, 0.), 0.)
+        self.assertTrue(self.nav.entry_hold)
+
+    def test_braking_grace_needs_current_nearby_crate_and_small_velocity(self):
+        aligned = replace(self.frame, first_relative=np.array([.52,-.40]))
+        self.assertAlmostEqual(self.nav.observation_deadline(aligned,20.),10.74)
+        lost = replace(aligned, first_seen_streak=0)
+        self.assertAlmostEqual(self.nav.observation_deadline(lost,20.),10.+FIRST_BOX_LEASE_S)
+        self.nav.frame = aligned
+        hook = self.nav.publication(aligned,20.)
+        with self.nav.control_lock:
+            np.testing.assert_array_equal(hook(10.6,np.array([0.,.26,0.]),self.attitude),0.)
+            np.testing.assert_array_equal(hook(10.75,np.array([0.,.02,0.]),self.attitude),0.)
+        self.nav.frame = replace(aligned, position=np.array([.61,.29]))
+        self.nav.command(10.60, 0.)
+        self.assertEqual(self.nav.phase,'enter')
+
+    def test_two_later_landmarks_can_confirm_completion_but_not_resume_strafe(self):
+        self.nav.command(10.01, 0.)
+        # The first crate was already seen on the passing side. Both later
+        # crates now place it at the entrance goal.
+        self.nav.frame = replace(self.frame, stamp=11., first_seen_streak=0,
+                                 first_relative=np.array([.55,-.41]),
+                                 corroborated_relative=np.array([.39,-.42]), corroborated_stamp=11.)
+        np.testing.assert_array_equal(self.nav.command(11.03, 0.), 0.)
+        self.assertTrue(self.nav.entry_hold)
+        self.assertEqual(self.nav.index, 0)
+        self.nav.frame = replace(self.nav.frame, position=np.array([.61,.29]))
+        np.testing.assert_array_equal(self.nav.command(11.05, 0.), 0.)
+        self.assertEqual(self.nav.phase, 'along')
+        self.assertIsNone(self.nav.entry_hold)
+
+
+if __name__ == '__main__':
+    unittest.main()
