diff --git a/scripts/test_rt13_passage.py b/scripts/test_rt13_passage.py
new file mode 100644
index 0000000000000000000000000000000000000000..e3127e4f22425de0af62c4b37d26a6d3b1f4ab72
--- /dev/null
+++ b/scripts/test_rt13_passage.py
@@ -0,0 +1,94 @@
+"""Passing decisions through the shipping perception, command and publication paths."""
+from dataclasses import replace
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import unittest
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from navigation.box_passage import Edge, PassageChoice
+from navigation.box_servo import BoxServo, BoxFrame, FIRST_BOX_LEASE_S
+from test_ground_color_integration import CAMERA_POSITION, CAMERA_ROTATION, camera_perception, perspective_scene
+
+
+class PassageTests(unittest.TestCase):
+    def see(self, box_y, hide=None):
+        frame, labels = perspective_scene([[25,130,50]], box_centers=[(.87,box_y)])
+        camera = camera_perception()
+        if hide == 'tape':
+            rgb = frame.rgb.copy()
+            rgb[np.min(rgb, axis=2)>150] = [19,125,78]
+            frame = replace(frame, rgb=rgb)
+        if hide == 'floor':
+            xy = (camera.rays*frame.depth[...,None])@CAMERA_ROTATION.T+CAMERA_POSITION
+            depth = frame.depth.copy()
+            depth[(labels==-1)&(abs(xy[...,0]-.87)<.23)&(abs(xy[...,1])<.23)] = np.nan
+            frame = replace(frame, depth=depth)
+        servo = BoxServo()
+        tracker = SimpleNamespace(xy=np.zeros(2),odometry=SimpleNamespace(accepted=False))
+        for t in (1.,1.15):
+            capture = replace(frame,time=t)
+            observation, _ = camera.inspect_lane(capture, np.eye(3))
+            servo.observe(capture,np.eye(3),camera,tracker,0.,observation.lane)
+            servo.commit_frame()
+        self.assertIn(0,servo.visible)
+        return servo, servo.command(1.16,0.)
+
+    def test_rgbd_mirror_selects_wider_floor(self):
+        for y,side in ((-.15,1),(.15,-1)):
+            with self.subTest(y=y):
+                servo,command = self.see(y)
+                self.assertEqual(servo.side,side)
+                self.assertGreater(command[1]*side,.1)
+                self.assertAlmostEqual(servo.passages[0].widths[int(side>0)],.30,delta=.01)
+
+    def test_narrow_or_unseen_passages_hold_translation(self):
+        for y,hidden in ((0.,None),(.15,'tape'),(.15,'floor')):
+            with self.subTest(y=y,hidden=hidden):
+                servo,command=self.see(y,hidden)
+                self.assertEqual(servo.side,0)
+                self.assertTrue(servo.passage_wait)
+                np.testing.assert_array_equal(command[:2],0.)
+
+    def test_single_edge_needs_two_captures_and_obstruction_revokes_choice(self):
+        choice=PassageChoice()
+        edges=[Edge(.40,0.,.45,.95)]
+        x,y=np.meshgrid(np.linspace(.67,.98,30),np.linspace(.115,.395,30))
+        floor=np.column_stack((x.ravel(),y.ravel()))
+        h=np.zeros(len(floor))
+        for stamp in (1.,1.):
+            choice.observe(stamp,edges,floor,h,(.88,0.),FIRST_BOX_LEASE_S)
+            self.assertEqual(choice.offset,0.)
+        choice.observe(1.2,edges,floor,h,(.88,0.),FIRST_BOX_LEASE_S)
+        self.assertGreater(choice.offset,0.)
+        blocked=h.copy()
+        blocked[(floor[:,0]>.81)&(floor[:,1]>.16)]=.14
+        choice.observe(1.4,[],floor,blocked,(.88,0.),FIRST_BOX_LEASE_S)
+        self.assertEqual(choice.offset,0.)
+
+    def test_crossing_holds_when_current_limbs_cannot_fit_between_faces(self):
+        servo=BoxServo()
+        servo.phase='shift'
+        servo.frame=BoxFrame(np.array([.50,0.]),np.zeros(2),(np.array([.40,-.02]),np.array([.60,.02])),
+                             0.,1.,2.,None,0.,passages=(.42,-.42),passage_seen=(2.,2.))
+        servo.limb_sample=(2.,np.array([[-.10,0.,0.,.02],[.10,0.,0.,.02]]))
+        np.testing.assert_array_equal(servo.command(2.,0.),0.)
+        self.assertTrue(servo.passage_wait)
+
+    def test_second_crate_uses_its_own_side_and_requires_current_match(self):
+        servo=BoxServo()
+        servo.phase='shift'
+        frame=BoxFrame(np.zeros(2),np.zeros(2),(np.array([.4,.02]),np.array([.90,.01])),
+                       0.,1.,2.,None,0.,passages=(.42,.42),passage_seen=(1.,1.))
+        servo.frame=frame
+        np.testing.assert_array_equal(servo.command(2.,0.),0.)
+        servo.frame=replace(frame,passage_seen=(1.,2.))
+        self.assertGreater(servo.command(2.,0.)[1],0.)
+        servo.frame=replace(frame,passages=(.42,0.))
+        np.testing.assert_array_equal(servo.command(2.,0.),0.)
+
+
+if __name__=='__main__':
+    unittest.main()
